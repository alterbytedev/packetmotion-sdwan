{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-isolated/types/**/*.ts",
    ".next-isolated/dev/types/**/*.ts",
    ".next-agent/types/**/*.ts",
    ".next-agent/dev/types/**/*.ts",
    ".next-wireguard-review/types/**/*.ts",
    ".next-wireguard-review/dev/types/**/*.ts",
    ".next-wireguard-final/types/**/*.ts",
    ".next-wireguard-final/dev/types/**/*.ts",
    ".next-wireguard-regression/types/**/*.ts",
    ".next-wireguard-regression/dev/types/**/*.ts",
    ".next-lan-m1/types/**/*.ts",
    ".next-lan-m1/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-isolated",
    ".next-agent"
  ]
}
