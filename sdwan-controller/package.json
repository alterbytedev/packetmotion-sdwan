{
  "name": "sdwan-controller",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint src next.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "setup:admin": "node scripts/setup-admin.mjs",
    "init:admin": "node scripts/setup-admin.mjs",
    "setup:superadmin": "node scripts/setup-admin.mjs superadmin",
    "init:superadmin": "node scripts/setup-admin.mjs superadmin",
    "set:operator-role": "node scripts/set-operator-role.mjs",
    "migrate:auth": "node scripts/migrate-auth.mjs",
    "test": "node --test tests/*.test.mjs ../tests/*.test.mjs",
    "test:integration": "node scripts/test-isolated.mjs",
    "test:browser": "node scripts/test-isolated.mjs browser",
    "test:baseline": "node scripts/test-isolated.mjs baseline",
    "migrate:controller": "node scripts/migrate-controller.mjs",
    "errors:show": "node scripts/show-runtime-error.mjs",
    "test:visual": "node scripts/compare-browser-baseline.mjs",
    "test:agent": "node scripts/test-isolated.mjs agent",
    "build:agent-release": "node ../sdwan-edge/scripts/build-release.mjs",
    "init:device-ca": "node scripts/init-device-ca.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pngjs": "7.0.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
