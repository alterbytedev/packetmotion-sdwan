# Development PostgreSQL only. Copy to .env.local and supply your own credentials.
# Linux/macOS: cp .env.example .env.local && nano .env.local
# Replace CHANGE_ME below with your PostgreSQL password in .env.local.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sdwan_controller

# Run npm run migrate:auth, then npm run init:admin to prepare the database and operator access.
# Optional. The init command defaults to admin@admin.local.
# CONTROLLER_ADMIN_EMAIL=admin@admin.local
# CONTROLLER_SESSION_SECRET=<at least 32 random characters>

# Required in production for operator API CSRF protection; no trailing slash.
# CONTROLLER_PUBLIC_ORIGIN=https://controller.example.com

# Device enrollment/channel (HTTPS reverse proxy required for VM agents).
# Create a dedicated signer with npm run init:device-ca; do not replace an existing CA.
# CONTROLLER_DEVICE_CA_CERT=/absolute/private/path/device-ca.crt
# CONTROLLER_DEVICE_CA_KEY=/absolute/private/path/device-ca.key
# CONTROLLER_AGENT_PROXY_SECRET=<random hex secret, at least 32 characters>
# Public HTTPS origin printed in the Devices enrollment instructions (no trailing slash).
# Set this when the app is behind a proxy or the browser origin is not the device-reachable URL.
# CONTROLLER_ENROLLMENT_URL=https://controller.example.com
# CONTROLLER_AGENT_URL=https://controller.example.com
